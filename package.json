{
  "name": "glam-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "build:web": "npm run build --workspace=@glam/web",
    "dev:web": "npm run dev --workspace=@glam/web",
    "dev:mobile": "npm run start --workspace=@glam/mobile",
    "check:client-runtime": "node scripts/check-client-runtime.mjs",
    "contracts:generate": "openapi-typescript packages/contracts/openapi.json -o packages/contracts/api.d.ts",
    "test:client": "node tests/client/product.test.cjs",
    "test:web": "node tests/client/application.cjs",
    "build:preview": "node scripts/build-interactive-preview.mjs",
    "test:preview": "node tests/client/preview.cjs",
    "preview:serve": "node scripts/serve-interactive-preview.mjs",
    "typecheck:preview": "tsc --noEmit -p preview/tsconfig.json",
    "design:tokens": "node scripts/generate-consumer-tokens.mjs",
    "test:golden": "node scripts/check-golden-visuals.cjs --verify-candidates",
    "test:connections": "node tests/client/connected-contracts.cjs",
    "record:golden": "node scripts/record-golden-evidence.cjs",
    "test:approved-visuals": "node scripts/check-golden-visuals.cjs --compare-approved",
    "test:hosted-account": "node tests/client/hosted-account.cjs",
    "build:godaddy": "node scripts/build-godaddy-web.mjs",
    "test:public-config": "node --test tests/client/public-config.test.mjs",
    "test:godaddy": "node tests/client/godaddy-web.cjs",
    "typecheck:godaddy": "tsc --noEmit -p deploy/godaddy/tsconfig.json",
    "test:auth": "node tests/auth/contracts.cjs && node tests/auth/native-gate.cjs",
    "audit:launch:discover": "node scripts/launch/discover.cjs",
    "audit:launch:routes": "node scripts/launch/clickthrough.cjs",
    "audit:launch:actions": "node scripts/launch/interactions.cjs",
    "audit:launch:workspaces": "node scripts/launch/workspaces.cjs",
    "test:login-hydration": "node tests/launch/login-hydration.cjs",
    "test:launch-accessibility": "node tests/launch/accessibility.cjs",
    "test:launch-keyboard": "node scripts/launch/keyboard.cjs",
    "test:launch-gates": "node --test tests/launch/release-gates.test.cjs tests/launch/railway-release-lock.test.cjs tests/launch/qa-gates.test.cjs",
    "test:auth-branding": "node tests/auth-branding/visual.cjs",
    "test:creator": "node tests/creator/visual.cjs",
    "test:deployment-config": "node --test tests/client/ci-targets.test.mjs && node tests/client/mobile-build-config.cjs",
    "test:workspace-access": "node tests/workspace/access.cjs && node tests/workspace/production.cjs && node tests/workspace/layout-review.cjs",
    "test:artwork": "node tests/branding/artwork.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "react-test-renderer": "19.3.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@expo/cli": {
      "glob": "14.0.3"
    },
    "@expo/fingerprint": {
      "glob": "14.0.3",
      "minimatch": "11.0.4"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "libphonenumber-js": "1.13.15"
  }
}
