# DOCUMENTATION ONLY. Configure actual secrets in the deployment secret manager.
# Do not put this file into a browser build. Do not enable production integrations by copying it.
OPENAI_API_KEY=
# Managed environment alternative: OPENAI_* binding targets are reserved.
# Server-only fallback when OPENAI_API_KEY is absent. Never expose either to the client.
GLAM_OPENAI_API_KEY=
GLAM_OPENAI_MODEL=
REPLICATE_API_TOKEN=
FASHN_API_KEY=
GLAM_FASHN_MODEL=
# Comma-separated exact origins for qualified, private signed source images.
GLAM_PRIVATE_IMAGE_ORIGINS=
GOOGLE_MAPS_API_KEY=
# False until weather licensing/commercial entitlement is reviewed; this is not approval itself.
GLAM_WEATHER_LICENSE_APPROVED=false
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENTRY_DSN=
# These remain disconnected until separate G0/commercial authorization. No adapter initializes them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PEACH_ENTITY_ID=
PEACH_ACCESS_TOKEN=
