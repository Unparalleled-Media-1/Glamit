# Documentation only. Provision actual credentials in secure environment settings; do not commit them.
# Keys must be TEST mode. Live keys are rejected. No .env loader initializes this integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_TEST_CONNECTED_ACCOUNT_ID=
# Additional verified US TEST connected accounts. Two are needed for real multi-merchant tests.
STRIPE_TEST_ADDITIONAL_CONNECTED_ACCOUNT_IDS=
# Local persistent sandbox. MUST differ from the disposable GLAM_TEST_DATABASE_URL database.
STRIPE_TEST_DATABASE_URL=postgresql+psycopg://glam:REPLACE_IN_SECRET_MANAGER@127.0.0.1:5432/glam_stripe_sandbox_test
STRIPE_TEST_RETURN_URL=https://YOUR_APPROVED_TEST_SITE/stripe-test/return
STRIPE_TEST_REFRESH_URL=https://YOUR_APPROVED_TEST_SITE/stripe-test/refresh
# Optional client settings; server-hosted Checkout needs no browser secret.
STRIPE_PUBLISHABLE_KEY=
# OAuth client ID is not used by this Account Links onboarding implementation.
STRIPE_CONNECT_CLIENT_ID=
# No production Supabase or Mercury credentials belong in this sandbox.
