{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/web.Dockerfile",
    "watchPatterns": ["apps/web/**", "packages/**", "package.json", "package-lock.json", ".dockerignore", "scripts/check-browser-auth-config.mjs", "scripts/public-supabase-config.mjs", "deploy/railway/web*"]
  },
  "deploy": {
    "healthcheckPath": "/api/health/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
