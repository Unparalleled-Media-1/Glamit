{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/worker.Dockerfile",
    "watchPatterns": ["services/api/**", "pyproject.toml", "uv.lock", "scripts/start-api.py", "scripts/start-worker.py", "deploy/railway/worker*"]
  },
  "deploy": {
    "startCommand": "python scripts/start-worker.py privacy-worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
